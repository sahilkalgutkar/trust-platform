# Host ports the three services publish. 8081-8083 are a common range for
# whatever else is already running, so each is overridable. Only the host side
# moves -- inside the compose network the services still reach each other, and
# Postgres, Redis and Kafka, on the standard ports.
#
# IDENTITY_HOST_PORT is the one exception to "only the host side moves": both
# services' ISSUER_BASE_URL is built from it, because the issuer is what a
# token claims to an outside caller and what authz-service compares `iss`
# against. Leaving it pinned to 8081 while the port moved made the smoke test
# fail on a token whose issuer named a port nothing was listening on.
#
# The smoke test reads its own URLs, so override both together:
#   IDENTITY_HOST_PORT=8181 AUTHZ_HOST_PORT=8182 AUDIT_HOST_PORT=8183 \
#     docker compose up --build
#   IDENTITY_URL=http://localhost:8181 AUTHZ_URL=http://localhost:8182 \
#     AUDIT_URL=http://localhost:8183 ./scripts/smoke-test.sh

IDENTITY_HOST_PORT=8081
AUTHZ_HOST_PORT=8082
AUDIT_HOST_PORT=8083
